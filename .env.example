# Copia este archivo como .env.local y completa los valores.

# Número de WhatsApp de ventas: formato internacional, solo dígitos (ej: 573001234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=3018147846

# URL pública donde se publicará la landing (para SEO, sitemap y Open Graph)
NEXT_PUBLIC_SITE_URL=https://megabusiness.tech

# (Opcional) Enlace al canal o comunidad de WhatsApp
NEXT_PUBLIC_COMMUNITY_URL=

# --- Solo servidor (no NEXT_PUBLIC): API privada del panel para crear demos ---
# Token compartido con el panel (SOCIOS_AUTOMATION_TOKEN del .env de /opt/socios-crm)
PANEL_API_TOKEN=
# PANEL_API_URL=http://socios-crm-web:8080/api/n8n/create-demo.php
