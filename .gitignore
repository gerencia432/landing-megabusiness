# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# typescript
*.tsbuildinfo
next-env.d.ts

# env files: solo se versiona la plantilla
.env*
!.env.example

# secretos y certificados
*.pem
*.key
*.crt
*.p12

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/

# backups, volcados y comprimidos (no deben llegar al repositorio)
*.bak
*.bak-*
*.backup
*.sql
*.sql.gz
*.zip
*.tar
*.tar.gz

# docker: ajustes locales
docker-compose.override.yml

# vercel
.vercel

# sistema operativo
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# editores
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# herramientas locales
.claude/settings.local.json
